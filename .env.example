LOADPILOT_DB=artifacts/demo.db
LOADPILOT_GENERATED_DIR=artifacts/generated-tests
LOADPILOT_K6_BIN=.tools/k6/k6-v1.6.1-windows-amd64/k6.exe
LOADPILOT_EMBEDDED_WORKER=true
LOADPILOT_ALLOWED_HOSTS=127.0.0.1,localhost,sandbox-target
LOADPILOT_SANDBOX_URL=http://127.0.0.1:8080
LOADPILOT_MAX_VUS=100
LOADPILOT_MAX_DURATION_SECONDS=7200
LOADPILOT_MAX_RPS=100
# Optional real AI. Do not commit credentials. Base URL includes /v1.
LOADPILOT_LLM_BASE_URL=https://api.openai.com/v1
LOADPILOT_LLM_MODEL=
LOADPILOT_LLM_API_KEY=
LOADPILOT_LLM_JSON_MODE=true
# Enable only for the local sandbox demo; launcher creates a per-session token.
LOADPILOT_ALLOW_SANDBOX_REMEDIATION=false
LOADPILOT_SANDBOX_CONTROL_TOKEN=

LOADPILOT_LLM_MAX_TOKENS=2500
