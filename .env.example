LOADPILOT_DB=artifacts/demo.db
LOADPILOT_GENERATED_DIR=artifacts/generated-tests
LOADPILOT_K6_BIN=.tools/k6/k6-v1.6.1-windows-amd64/k6.exe
LOADPILOT_EMBEDDED_WORKER=true
LOADPILOT_ALLOWED_HOSTS=127.0.0.1,localhost,sandbox-target
LOADPILOT_SANDBOX_URL=http://127.0.0.1:8080
LOADPILOT_MAX_VUS=100
LOADPILOT_MAX_DURATION_SECONDS=7200
LOADPILOT_MAX_RPS=100

# Optional model provider. Do not commit credentials.
# Naming a model is enough: Gemini names route to Google's OpenAI-compatible
# surface and read GEMINI_API_KEY or GOOGLE_API_KEY from the environment, other
# names route to OpenAI and read OPENAI_API_KEY. Set the key here to override.
# Leave blank to run entirely on the deterministic reader. A quota or outage on the
# named model is not a failure: the run keeps the pattern reading and records why.
LOADPILOT_LLM_MODEL=gemini-3.6-flash
LOADPILOT_LLM_API_KEY=
# Only needed for a provider that is neither Gemini nor OpenAI. Must include /v1.
LOADPILOT_LLM_BASE_URL=
LOADPILOT_LLM_JSON_MODE=true
LOADPILOT_LLM_MAX_TOKENS=2500
LOADPILOT_LLM_TIMEOUT=45
# Transient refusals only: rate limits, unavailability, a truncated or unreadable reply.
LOADPILOT_LLM_RETRIES=2

# Enable only for the local sandbox demo; launcher creates a per-session token.
LOADPILOT_ALLOW_SANDBOX_REMEDIATION=false
LOADPILOT_SANDBOX_CONTROL_TOKEN=

# Optional protection for API clients; leave blank for the local dashboard.
LOADPILOT_API_TOKEN=
LOADPILOT_MAX_ARTIFACT_BYTES=250000000
