FROM node:22-alpine AS web-build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM grafana/k6:1.6.1 AS k6-runtime

FROM python:3.11-slim
WORKDIR /app
COPY --from=k6-runtime /usr/bin/k6 /usr/local/bin/k6
COPY pyproject.toml README.md ./
COPY loadpilot ./loadpilot
COPY --from=web-build /web/dist ./web/dist
RUN pip install --no-cache-dir .
ENV LOADPILOT_DB=/app/data/loadpilot.db LOADPILOT_GENERATED_DIR=/app/generated-tests
EXPOSE 8000
CMD ["uvicorn", "loadpilot.api:app", "--host", "0.0.0.0", "--port", "8000"]
